{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apexdental.com.mt"
        }
      ],
      "destination": "https://www.apexdentalmalta.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.apexdental.com.mt"
        }
      ],
